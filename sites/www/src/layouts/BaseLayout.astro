---
/**
 * BaseLayout: the document shell for every page.
 *
 * Fonts and icons are npm packages (Inter via Fontsource, Font Awesome Free),
 * as on pixelci-sales-site, bundled by Astro. Tokens: src/styles/tokens.css
 * (PixelCI system, v8s indigo); site.css is the marketing layer on top.
 */
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fortawesome/fontawesome-free/css/fontawesome.css';
import '@fortawesome/fontawesome-free/css/solid.css';
import '@fortawesome/fontawesome-free/css/brands.css';
import '../styles/tokens.css';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  /** Social card in public/og/ (generated by `npm run og`). */
  image?: string;
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
  /** JSON-LD objects for this page, added to the site-wide Organization. */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = 'v8s (Visual k8s) is a fast, multi-cluster Kubernetes manager for desktop, browser and phone. A Go agent keeps compact projections of your clusters and sends the UI only the rows on screen. Problems view, Flux, Helm, Kyverno, Trivy, Hubble. MIT licensed.',
  image = 'home',
  noindex = false,
  schema = [],
} = Astro.props;

const site = Astro.site ?? new URL('https://v8s.io');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(`/og/${image}.png`, site).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.origin}/#organization`,
  name: 'Zyno Consulting',
  legalName: 'Signal24 LLC',
  url: 'https://zyno.consulting/',
  brand: { '@type': 'Brand', name: 'v8s', url: site.origin + '/' },
  sameAs: ['https://github.com/zyno-io'],
};
const jsonLd = [organization, ...schema.map((s) => ({ '@context': 'https://schema.org', ...s }))];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="v8s" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="v8s, the multi-cluster Kubernetes manager: the Pods view across three clusters with the command bar open." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="theme-color" content="#f6f7f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0d10" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      /* Before first paint: mark JS (so motion starts hidden only when it can
         run) and apply a pinned theme, so a reader who chose dark never sees a
         light flash. sessionStorage: the choice holds for the tab, then the OS
         setting wins again, like the app's System theme. */
      document.documentElement.classList.add('js');
      try {
        var t = sessionStorage.getItem('v8s-theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
    <script>
      import '../scripts/theme';
    </script>
  </body>
</html>
