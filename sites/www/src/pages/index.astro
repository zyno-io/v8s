                      <i class="fa-solid fa-arrow-down" aria-hidden="true" />Download
                    </a>
                  </li>
                ))
              }
            </ul>
            <h3 class="dls__hd dls__hd--sp">Container and chart</h3>
            <pre class="snippet"><code>docker run --rm -p 7931:7931 \
  -v $PWD/config.yaml:/etc/v8s/config.yaml:ro \
  {site.image}:{VERSION}</code></pre>
            <p class="fine dls__note"><code>linux/amd64</code> and <code>linux/arm64</code>. Build from source: Go 1.27 and Node 26, see the <a href={site.repo}>README</a>.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

