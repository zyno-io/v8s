            <a href={sumsUrl} class="more" download>checksums.txt<i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
          </div>
        </div>

        <div class="dls">
          <div class="dls__group">
            <h3 class="dls__hd">Desktop app</h3>
            <ul class="dls__list">
              {
                platforms.map((p) => (
                  <li class="dls__row" data-dl-row={p.id}>
