---
/**
 * SiteFooter: the Zyno Consulting band (owner's brief: "Need help with your
 * Kubernetes…? Zyno Consulting can help", linking https://zyno.consulting),
 * then the link columns.
 *
 * The band uses only claims made on zyno.consulting itself
 * (zyno-consulting-web: software-consulting "Infrastructure & DevOps" and
 * "Embedded consulting", the Kubernetes and AWS migration in consulting-samples).
 * v8s never needs Zyno Consulting; the copy says who makes it and offers help.
 */
import BrandMark from './BrandMark.astro';
import { site, doc } from '../data/site';

const cols = [
  {
    title: 'v8s',
    links: [
      { label: 'Why it’s fast', href: '/#fast' },
      { label: 'Problems', href: '/#problems' },
      { label: 'Flux and Helm', href: '/#gitops' },
      { label: 'Run it', href: '/#run' },
      { label: 'Download', href: '/#download' },
    ],
  },
  {
    title: 'Docs',
    links: [
      { label: 'Getting started', href: doc.start },
      { label: 'Install', href: doc.install },
      { label: 'Hosted mode', href: doc.hosted },
      { label: 'Navigation and keys', href: doc.navigation },
      { label: 'FAQ', href: doc.faq },
    ],
  },
  {
    title: 'Project',
    links: [
      { label: 'GitHub', href: site.repo },
      { label: 'Releases', href: site.releases },
      { label: 'Changelog', href: site.changelog },
      { label: 'Issues', href: site.issues },
      { label: 'MIT licence', href: site.licenceText },
    ],
  },
];
---

<footer class="foot">
  <div class="wrap">
    <section class="zc" aria-labelledby="zc-title">
      <div class="zc__copy">
        <h2 id="zc-title" class="zc__title">Need a hand with your Kubernetes platform?</h2>
        <p class="zc__body">
          v8s is built by Zyno Consulting. We deploy, observe and operate infrastructure for teams from startups to
          Fortune 100, from cloud infrastructure and CI/CD pipelines to monitoring and incident response, and we’ve
          moved legacy workloads onto Kubernetes and AWS in record time. We can own it end to end, or embed with your engineers.
        </p>
      </div>
      <a href={site.consulting} class="btn btn--lg zc__cta">
        <span class="zc__mark" aria-hidden="true"></span>Talk to Zyno Consulting<i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </a>
    </section>
  </div>

  <div class="wrap foot__cols">
    <div class="foot__about">
      <BrandMark />
      <p class="fine">Visual k8s: a fast, multi-cluster Kubernetes manager for desktop, browser and phone. Open source under the MIT licence.</p>
    </div>
    {
      cols.map((c) => (
        <div>
          <h2 class="foot__hd">{c.title}</h2>
          <ul class="foot__list">
            {c.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="wrap foot__base">
    <span>© 2026 {site.maker}</span>
    <span>
      <a href={site.consulting}>zyno.consulting</a> · <a href={site.privacy}>Privacy</a> · <a href={site.terms}>Terms</a>
    </span>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  /* Zyno Consulting band: the dark chrome strip the Zyno sites use for their CTA bands,
     drawn here in the page's own tokens (near-black in both themes). */
  .zc {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 32px 56px;
    margin-top: 56px;
    padding: 40px 44px;
    border-radius: var(--radius-lg);
    background: #0c0d10;
    color: #ececf0;
    box-shadow: var(--shadow-md);
  }
  :global(:root[data-theme='dark']) .zc {
    background: var(--surface-3);
    border: 1px solid var(--border-strong);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .zc {
      background: var(--surface-3);
      border: 1px solid var(--border-strong);
    }
  }
  .zc__title {
    font-size: var(--t-sub);
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 650;
    color: #fff;
  }
  .zc__body {
    margin-top: 12px;
    max-width: 68ch;
    color: #aeb2bd;
    font-size: var(--t-sm);
    line-height: 1.65;
  }
  .zc__cta {
    border-color: #fff;
    background: #fff;
    color: #15171c;
    font-weight: 600;
  }
  .zc__cta:hover {
    background: #eceef2;
  }
  .zc__cta i {
    font-size: 0.8em;
    transition: translate 160ms ease;
  }
  .zc__cta:hover i {
    translate: 3px 0;
  }
  /* Zyno's cobalt square, as the Zyno wordmarks draw it. */
  .zc__mark {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: #2855d4;
  }

  .foot__cols {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 32px;
    padding-top: 56px;
    padding-bottom: 40px;
  }
  .foot__about .fine {
    max-width: 300px;
    margin-top: 14px;
  }
  .foot__hd {
    margin-bottom: 12px;
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--text);
  }
  .foot__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .foot__list a {
    color: var(--text-2);
    font-size: var(--t-sm);
    text-decoration: none;
  }
  .foot__list a:hover {
    color: var(--text);
    text-decoration: underline;
  }
  .foot__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    position: relative;
    padding-top: 20px;
    padding-bottom: 28px;
    font-size: var(--t-xs);
    color: var(--text-3);
  }
  .foot__base a {
    color: var(--text-2);
  }
  .foot__base::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--gutter);
    right: var(--gutter);
    height: 1px;
    background: var(--border);
  }
  @media (max-width: 900px) {
    .zc {
      grid-template-columns: minmax(0, 1fr);
      padding: 28px 24px;
    }
    .zc__cta {
      justify-self: start;
    }
    .foot__cols {
      grid-template-columns: repeat(3, 1fr);
    }
    .foot__about {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .foot__cols {
      grid-template-columns: repeat(2, 1fr);
    }
    .zc__cta {
      justify-self: stretch;
    }
  }
  @media (max-width: 820px) {
    .foot__list {
      gap: 0;
    }
    .foot__list a {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
    }
  }
</style>
