---
/**
 * The v8s mark (docs/public/logo.svg in the v8s repo: a white "v" stroke and
 * dot on an indigo tile) beside the lower-case wordmark, as in the app's top bar.
 */
interface Props {
  size?: 'md' | 'lg';
}
const { size = 'md' } = Astro.props;
---

<span class:list={['brand', `brand--${size}`]}>
  <svg class="brand__mark" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#4f46e5"></rect><path d="M14 20l12 26a2 2 0 0 0 3.6 0L40 24" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"></path><circle cx="48" cy="19" r="5" fill="#fff"></circle></svg>
  <span class="brand__name">v8s</span>
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--text);
  }
  .brand__mark {
    width: 26px;
    height: 26px;
  }
  .brand__name {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .brand--lg .brand__mark {
    width: 32px;
    height: 32px;
  }
  .brand--lg .brand__name {
    font-size: 22px;
  }
</style>
