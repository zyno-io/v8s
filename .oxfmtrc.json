{
    "tabWidth": 4,
    "singleQuote": true,
    "printWidth": 150,
    "arrowParens": "avoid",
    "trailingComma": "none",
    "sortImports": {
        "groups": [
            "type-import",
            [
                "value-builtin",
                "value-external"
            ],
            "type-internal",
            "value-internal",
            [
                "type-parent",
                "type-sibling",
                "type-index"
            ],
            [
                "value-parent",
                "value-sibling",
                "value-index"
            ],
            "unknown"
        ]
    },
    "ignorePatterns": [
        "dist/**",
        ".yarn/**",
        "**/out/**",
        "packages/client/src/protocol.gen.ts"
    ],
    "overrides": [
        {
            "files": [
                "*.yaml",
                "*.yml"
            ],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
