{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "test/**/*", "perf/**/*", "vite.config.ts"],
    "compilerOptions": {
        "composite": false,
        "noEmit": true,
        "ignoreDeprecations": "6.0",
        "allowImportingTsExtensions": true,
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "types": ["vite/client", "node"],
        "paths": { "@/*": ["./src/*"] }
    }
}
