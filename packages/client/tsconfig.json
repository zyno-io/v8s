{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2023", "DOM", "WebWorker"],
        "strict": true,
        "noUncheckedIndexedAccess": false,
        "skipLibCheck": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "types": ["vite/client"],
        "ignoreDeprecations": "6.0"
    },
    "include": ["src/**/*.ts"]
}
