{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2023"],
        "types": ["node"],
        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "ignoreDeprecations": "6.0"
    },
    "include": ["src/**/*.ts", "build.mjs"]
}
